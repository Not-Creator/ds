#include <stdio.h>

#define N 5

int queue[N];
int front = -1;
int rear = -1;

// Enqueue operation
void enqueue(int x)
{
    if ((rear + 1) % N == front)
    {
        printf("Queue is Full (Overflow)\n");
    }
    else if (front == -1 && rear == -1)
    {
        front = rear = 0;
        queue[rear] = x;
    }
    else
    {
        rear = (rear + 1) % N;
        queue[rear] = x;
    }
}

// Dequeue operation
void dequeue()
{
    if (front == -1)
    {
        printf("Queue is Empty (Underflow)\n");
    }
    else
    {
        printf("Deleted item is %d\n", queue[front]);

        if (front == rear)
        {
            front = rear = -1;
        }
        else
        {
            front = (front + 1) % N;
        }
    }
}

// Display queue
void display()
{
    int i;

    if (front == -1)
    {
        printf("Queue is Empty\n");
        return;
    }

    printf("Queue elements are: ");

    i = front;
    while (1)
    {
        printf("%d ", queue[i]);

        if (i == rear)
            break;

        i = (i + 1) % N;
    }

    printf("\n");
}

int main()
{
    int choice, x;

    while (1)
    {
        printf("\n----- Circular Queue Menu -----\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:
            printf("Enter value to insert: ");
            scanf("%d", &x);
            enqueue(x);
            break;

        case 2:
            dequeue();
            break;

        case 3:
            display();
            break;

        case 4:
            printf("Exiting program...\n");
            return 0;

        default:
            printf("Invalid choice!\n");
        }
    }

    return 0;
}
