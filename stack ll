#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

struct Node *top = NULL;

// PUSH
void push(int x)
{
    struct Node *newNode = malloc(sizeof(struct Node));

    newNode->data = x;
    newNode->next = top;
    top = newNode;
}

// POP
void pop()
{
    if (top == NULL)
        printf("Stack is Empty\n");
    else
    {
        struct Node *temp = top;
        printf("Deleted: %d\n", top->data);
        top = top->next;
        free(temp);
    }
}

// DISPLAY
void display()
{
    struct Node *temp = top;

    while (temp != NULL)
    {
        printf("%d ", temp->data);
        temp = temp->next;
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    printf("Stack: ");
    display();

    pop();

    printf("\nAfter Pop: ");
    display();

    return 0;
}
