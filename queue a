#include <stdio.h>

#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

// INSERT
void enqueue(int x)
{
    if (rear == SIZE - 1)
        printf("Queue is Full\n");
    else
    {
        if (front == -1)
            front = 0;

        rear++;
        queue[rear] = x;
    }
}

// DELETE
void dequeue()
{
    if (front == -1 || front > rear)
        printf("Queue is Empty\n");
    else
    {
        printf("Deleted: %d\n", queue[front]);
        front++;
    }
}

// DISPLAY
void display()
{
    if (front == -1 || front > rear)
        printf("Queue is Empty\n");
    else
    {
        for (int i = front; i <= rear; i++)
            printf("%d ", queue[i]);
    }
}

int main()
{
    enqueue(10);
    enqueue(20);
    enqueue(30);

    printf("Queue: ");
    display();

    dequeue();

    printf("\nAfter Delete: ");
    display();

    return 0;
}
